# Copie para .env.local (computador) e preencha. Na Vercel: Settings > Environment Variables.
# Este projeto NÃO tem chave secreta: pagamento, IA e service_role ficam no app.cmkcogit.com.br.
SUPABASE_URL=https://SEU-PROJETO.supabase.co   # o MESMO projeto do app
SUPABASE_ANON_KEY=
