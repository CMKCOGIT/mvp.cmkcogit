SITE_URL=https://www.cmkcogit.com.br
COOKIE_DOMAIN=.cmkcogit.com.br                  # login único com o app (vazio no computador)
TURNSTILE_SITE_KEY=                             # captcha (a chave secreta fica no painel do Supabase)
WHATSAPP_SUPORTE=5517981568889
# Só para `npm run tipos` (gerar types/database.d.ts do banco). Nunca na Vercel:
SUPABASE_PROJECT_ID=
